-- minigame
minigame = {
	minx = 10,
	maxx = 108,
	
	y = 80,

	active = false
}

function minigame:setup()
	self.fish = {
			x = 64,
			target = 64,
		
			-- 20 frame grace period
			timer = 20,
			dashing = false,
			
			progress = 50,
			flipped = false,
			
			reeling = true,
			sp = 7
		}
		
		-- todo
		-- increase width based
		-- on level
		local w = player.rod.width
		self.bar = {
			x = self.fish.x - w / 2,
			w = w,
			h = 7,
			
			spd = 1.5
		}

		self.active = true
end

function minigame:update()
	-- bar goes first
	local bar = self.bar
	
	if btn(⬅️) then
		bar.x -= bar.spd
		if bar.x <= self.minx then
			bar.x = self.minx
		end
	elseif btn(➡️) then
		bar.x += bar.spd
		
		if bar.x >= self.maxx - 5 then
			bar.x = self.maxx - 5
		end
	end
	
	local fish = self.fish
	
	fish.timer -= 1
	if fish.timer <= 0 then
		fish.target = 
			randr(
				minigame.minx, 
				minigame.maxx
			)
	
		fish.timer = 
			randr(
				30, 
				90 - (player.hooked.aggr * 50)
			)

		fish.dashing = 
			rnd() < player.hooked.aggr
			
		fish.flipped = fish.x < fish.target
	end
	
	local spd = player.hooked.spd
	if fish.dashing then
		spd = player.hooked.dspd
	end
	
	if fish.x < fish.target then
		fish.x += spd
		if (fish.x > fish.target) fish.x = fish.target
	else
		fish.x -= spd
		if (fish.x < fish.target) fish.x = fish.target
	end
	
	if crect(
		bar.x, self.y, bar.w, bar.h,
		fish.x, self.y, 8, 8
	) then
		fish.reeling = true
	
		fish.sp = 7
		fish.progress += player.prate
		if fish.progress >= 100 then
			fish.progress = 100
		end
	else
		fish.reeling = false
	
		fish.sp = 8
		fish.progress -= player.lrate
		if fish.progress <= 0 then
			fish.progress = 0
		end
	end
	
	if fish.progress >= 100 then
		if btn(❎) then
			player.state = "caught"
			self.active = false
		end
	elseif fish.progress <= 0 then
		-- todo
		-- maybe an intermediary
		-- state??
		
		player.state = "walk"
		
		player.hooked = nil
		player.hooked_size = nil
		
		self.fish = nil
		self.bar = nil
		self.active = false
	end

end

function minigame:draw()
	-- background
	local offset = 5
	local bh = 35
	rrectfill(
		self.minx - offset, self.y - offset,
		self.maxx + offset * 2, bh, 3, 4 
	)

	rrect(
		self.minx - offset, self.y - offset,
		self.maxx + offset * 2, bh, 3, 7 
	)

	local fish = self.fish
	
	rrect(
		self.minx - 1, self.y - 1,
		self.maxx + 2, 10, 2, 
		7
	)
	
	rrectfill(
		self.minx, self.y, 
		self.maxx, 8, 1,
		1
	)
	
	-- player bar
	local bar = self.bar
	rrectfill(
		bar.x, self.y,
		bar.w, bar.h + 1, 2, 3
	)
	
	rrect(
		bar.x, self.y,
		bar.w, bar.h + 1, 2, 11
	)
	
	-- fish
	spr(fish.sp, 
		fish.x, self.y, 
		1, 1, 
		fish.flipped
	)
	
	-- progress
	print(flr(fish.progress) .. "%", self.minx, self.y + 10, 7)

	-- funny pixel worlds-like
	-- text
	if fish.reeling then
		local txt = "fish on!"
		if fish.progress >= 100 then
			txt = "fish on! ❎ to catch!"
		end
		
		local w = #txt * 4
		print(txt, 128 / 2 - w / 2, self.y + 20, 11)
	end
end

