-- game

game = {}

function game:init()
	self.area = areas.forest

	self.padding = 20

	player:init()
end

function game:update()
	if minigame.active then
		minigame:update()
		return
	end

	player:update()
end

function game:draw()
	cls(self.area.clr)

	camera(player.x - 60, player.y - 60)
	map(self.area.minx, self.area.miny)
	player:draw()
	
	camera(0, 0)
	
	if minigame.active then
		minigame:draw()
	end

	if player.state == "caught" then
		-- body
		rectfill(
			self.padding, self.padding,
			128 - self.padding,
			128 - self.padding,
			1
		)
		
		rect(
			self.padding - 1, self.padding - 1,
			128 - self.padding + 1,
			128 - self.padding + 1,
			6
		)
		
		local offset = 85
		
		-- fish name
		local name = player.hooked.name ..
			" (" .. player.hooked_size .. ")"

		print(name, 
			self.padding + 5, 
			128 - self.padding - offset, 
			7
		)
		
		-- separator
		line(
			self.padding, 
			128 - self.padding - offset + 7,
			128 - self.padding,
			128 - self.padding - offset + 7,
			7
		)
	
		print(player.hooked.xp .. " xp", self.padding + 5, self.padding + 15)

		-- placeholder img
		local ix, iy = 
			self.padding + 38,
			128 - self.padding - offset + 18
		
		spr(34, ix, iy)
		rect(ix - 1, iy - 1, ix + 9, iy + 9, 7)
	
		local wrap = 118 - self.padding * 2
		print(wordwrap(player.hooked.desc, wrap), self.padding + 5, self.padding + 35)
	end
end
